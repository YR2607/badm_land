{
  "git": {
    "deploymentEnabled": {
      "preview": true,
      "production": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.altius.md" }],
      "destination": "https://altius.md/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/ro",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/ro/about",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/ro/gallery",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/ro/services",
      "permanent": true
    },
    {
      "source": "/gyms",
      "destination": "/ro/gyms",
      "permanent": true
    },
    {
      "source": "/gyms/:slug",
      "destination": "/ro/gyms/:slug",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/ro/contact",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/ro/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/ro/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/static/:path*", "destination": "/admin/static/:path*" },
    { "source": "/vendor/:path*", "destination": "/admin/vendor/:path*" },
    { "source": "/manifest.webmanifest", "destination": "/admin/manifest.webmanifest" },
    { "source": "/favicon.ico", "destination": "/admin/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/admin/favicon.svg" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
