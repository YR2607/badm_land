{
  "git": {
    "deploymentEnabled": {
      "preview": true,
      "production": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.altius.md" }],
      "destination": "https://altius.md/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/ro",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/ro/about",
      "permanent": false
    },
    {
      "source": "/gallery",
      "destination": "/ro/gallery",
      "permanent": false
    },
    {
      "source": "/services",
      "destination": "/ro/services",
      "permanent": false
    },
    {
      "source": "/gyms",
      "destination": "/ro/gyms",
      "permanent": false
    },
    {
      "source": "/gyms/:slug",
      "destination": "/ro/gyms/:slug",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/ro/contact",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/ro/blog",
      "permanent": false
    },
    {
      "source": "/blog/:slug",
      "destination": "/ro/blog/:slug",
      "permanent": false
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/(.*)$", "dest": "/api/$1" },
    { "src": "^/data/(.*)$", "dest": "/data/$1" },
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/static/(.*)$", "dest": "/admin/static/$1" },
    { "src": "^/vendor/(.*)$", "dest": "/admin/vendor/$1" },
    { "src": "^/manifest\\.webmanifest$", "dest": "/admin/manifest.webmanifest" },
    { "src": "^/favicon\\.(ico|svg)$", "dest": "/admin/favicon.$1" },
    { "src": "^/admin$", "dest": "/admin/index.html" },
    { "src": "^/admin/.*$", "dest": "/admin/index.html" },
    { "src": ".*", "dest": "/index.html" }
  ]
}
